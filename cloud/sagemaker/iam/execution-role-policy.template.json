{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProjectBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["entity-resolution/*"]}}
    },
    {
      "Sid": "ProjectObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/entity-resolution/*"
    },
    {
      "Sid": "ReadProjectImages",
      "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": [
        "arn:aws:ecr:us-east-1:REPLACE_ACCOUNT_ID:repository/entity-resolution-cpu",
        "arn:aws:ecr:us-east-1:REPLACE_ACCOUNT_ID:repository/entity-resolution-neural"
      ]
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "CreateTaggedProjectJobs",
      "Effect": "Allow",
      "Action": ["sagemaker:CreateProcessingJob", "sagemaker:CreateTrainingJob"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "MLChallenge-EntityResolution",
          "aws:RequestTag/ManagedBy": "codex"
        }
      }
    },
    {
      "Sid": "ObserveAndStopPipelineJobs",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DescribeProcessingJob", "sagemaker:StopProcessingJob",
        "sagemaker:DescribeTrainingJob", "sagemaker:StopTrainingJob", "sagemaker:AddTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyThisExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/SageMakerEntityResolutionExecution",
      "Condition": {"StringEquals": {"iam:PassedToService": "sagemaker.amazonaws.com"}}
    },
    {
      "Sid": "LogsAndMetrics",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup", "logs:CreateLogStream", "logs:DescribeLogStreams", "logs:PutLogEvents",
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    }
  ]
}
